# Release wheels must embed the same portable source bytes on every build host.
# Explicit LF checkout semantics prevent Windows Git settings from rewriting
# Python and metadata files before maturin packages them.
* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Frozen fixture bytes are part of the benchmark identity.
/benchmarks/fixtures/** -text
/benchmarks/fixtures/** whitespace=-trailing-space
# Captured inputs are third-party snapshots, not project implementation code.
/benchmarks/fixtures/** linguist-vendored

# Captured diagnostic transcripts are content-addressed evidence.
/benchmarks/evidence/m22/current-x7-raw/*.txt -text
/benchmarks/evidence/m22/current-x7-raw/*.txt whitespace=-trailing-space

*.zip binary
*.feather binary
*.parquet binary

# Preserve immutable X8 qualification transcripts, including diagnostic whitespace.
/benchmarks/evidence/x8-*/** -text
/benchmarks/evidence/x8-*/** whitespace=-trailing-space,-blank-at-eof
*.nfitrace binary
*.gz binary
