  system_v3_2_name = 'system_v3_2'
  system_v3_name = 'system_v3'
  system_v4_bad_trade_exit_enable = True
  system_v4_buyback_1_derisk_futures = -0.08
  system_v4_buyback_1_derisk_spot = -0.08
  system_v4_buyback_1_distance_ratio_negative_futures = -0.04
  system_v4_buyback_1_distance_ratio_negative_spot = -0.04
  system_v4_buyback_1_distance_ratio_positive_futures = 0.02
  system_v4_buyback_1_distance_ratio_positive_spot = 0.02
  system_v4_buyback_1_enable = False
  system_v4_buyback_1_stake_futures = 1.0
  system_v4_buyback_1_stake_spot = 1.0
  system_v4_buyback_1_use_derisk = True
  system_v4_derisk_level_1_enable = True
  system_v4_derisk_level_1_futures = [-0.18, -0.35]
  system_v4_derisk_level_1_spot = [-0.06, -0.12]
  system_v4_derisk_level_1_stake_futures = 0.2
  system_v4_derisk_level_1_stake_spot = 0.2
  system_v4_derisk_level_2_enable = True
  system_v4_derisk_level_2_futures = [-0.24, -0.54]
  system_v4_derisk_level_2_spot = [-0.08, -0.18]
  system_v4_derisk_level_2_stake_futures = 0.3
  system_v4_derisk_level_2_stake_spot = 0.3
  system_v4_derisk_level_3_enable = True
  system_v4_derisk_level_3_futures = [-0.3, -0.6]
  system_v4_derisk_level_3_spot = [-0.1, -0.2]
  system_v4_derisk_level_3_stake_futures = 0.5
  system_v4_derisk_level_3_stake_spot = 0.5
  system_v4_derisk_level_4_enable = False
