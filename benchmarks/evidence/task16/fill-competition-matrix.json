  },
  "source_corrections": [
    {
      "id": "T16-ORDER-TYPE-EXPANSION",
      "fact": "NFI source omits order_types and therefore inherits official limit entry/exit defaults; limit is certification scope and market is explicit-config comparison scope"
    },
    {
      "id": "T16-FALLTHROUGH",
      "fact": "official _check_trade_exit continues its for-loop after _get_exit_for_signal returns None; lower-priority same-candle candidates are attempted"
    },
    {
      "id": "T16-MIN-STAKE-STAGE",
      "fact": "official minimum stake is validated before amount truncation and is not rechecked afterward; only zero truncated amount rejects"
    },
    {
      "id": "T16-FEE-SCOPE",
      "fact": "Backtesting uses one self.fee for both LocalTrade fee_open and fee_close; NFI custom fee fields remain separately reachable strategy calculations"
    }
  ],
  "verdict": "official_oracle_matrix_captured_qualified"
}
