{
  "schema_version": "1.0.0",
  "roadmap_id": "nfi-backtest-engine-post-v1.1.0",
  "updated_at": "2026-08-15",
  "execution": {
    "default_working_directory": ".",
    "placeholder_rules": {
      "task_id": "Selected task identifier from roadmap-state.json",
      "commit_sha": "Current candidate commit or working-tree identity",
      "artifact_dir": ".nfi/roadmap-acceptance/{task_id}/{commit_sha}"
    },
    "run_required_commands_in_order": true,
    "stop_on_first_failure": true,
    "record_exit_code_and_output_sha256": true,
    "never_overwrite_existing_artifact_dir": true
  },
  "commands": {
    "planning_json": {
      "command": "jq empty planning/roadmap-state.json planning/acceptance-commands.json planning/compatibility-fixtures.json planning/futures-discovery-policy.json planning/futures-discovery-config.json planning/spot-discovery-policy.json planning/spot-discovery-config.json",
      "working_directory": ".",
      "platform": "linux",
      "timeout_seconds": 30,
      "required": true,
      "availability": "available",
      "mutates_external_state": false
    },
    "diff_check": {
      "command": "git diff --check",
      "working_directory": ".",
      "platform": "any",
      "timeout_seconds": 30,
      "required": true,
      "availability": "available",
      "mutates_external_state": false
    },
    "lock_check": {
      "command": "uv lock --check",
      "working_directory": ".",
      "platform": "any",
      "timeout_seconds": 120,
      "required": true,
      "availability": "available",
      "mutates_external_state": false
    },
    "ruff": {
      "command": "uv run ruff check .",
      "working_directory": ".",
      "platform": "any",
      "timeout_seconds": 300,
      "required": true,
      "availability": "available",
      "mutates_external_state": false
    },
    "basedpyright": {
      "command": "uv run basedpyright --level error python/nfi_backtest_engine",
      "working_directory": ".",
      "platform": "any",
      "timeout_seconds": 300,
      "required": true,
      "availability": "available",
      "mutates_external_state": false
    },
    "python_all": {
      "command": "uv run pytest -q",
      "working_directory": ".",
      "platform": "any",
      "timeout_seconds": 1800,
      "required": true,
      "availability": "available",
      "mutates_external_state": false
    },
    "rust_fmt": {
      "command": "cargo fmt --all -- --check",
      "working_directory": "rust",
      "platform": "any",
      "timeout_seconds": 300,
      "required": true,
      "availability": "available",
      "mutates_external_state": false
    },
