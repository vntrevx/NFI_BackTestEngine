{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfi.local/schemas/native-score-machine-record-v2.json",
  "title": "Native scorecard Full X7 performance machine observation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "record_type", "semantic_identity", "producer", "context", "inputs", "observation"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "gate_id": {"const": "deterministic_performance_resource_proof"},
    "record_type": {"const": "full_x7_performance_certificate"},
    "semantic_identity": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity_sha256", "run_id"],
      "properties": {
        "role": {"const": "full-x7-performance-certificate-verifier"},
        "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "string", "minLength": 1}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_identity_sha256", "candidate_identity_sha256", "mode_contract", "platform", "workload_sha256", "run_id", "nonce"],
      "properties": {
        "source_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mode_contract": {"enum": ["binance-spot", "binance-usdtm-isolated"]},
        "platform": {"const": "linux"},
        "workload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_id": {"type": "string", "minLength": 1},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "path", "sha256"],
        "properties": {
          "field": {"const": "certificate_sha256"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "observation": {"type": "object"}
  }
}
