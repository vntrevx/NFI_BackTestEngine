{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vntrevx/NFI_BackTestEngine/schemas/regression-contract-v1.schema.json",
  "title": "NFI Backtest Engine regression contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "sealed_at",
    "baseline",
    "repository_files",
    "cli",
    "full_state_fixtures",
    "behavior_contracts",
    "result_artifacts",
    "releases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sealed_at": {
      "type": "string",
      "format": "date"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_commit",
        "spot_release_commit",
        "strategy_upstream_commit",
        "strategy_sha256",
        "spot_surface_sha256",
        "futures_surface_sha256"
      ],
      "properties": {
        "release_commit": {
          "$ref": "#/$defs/sha1"
        },
        "spot_release_commit": {
          "$ref": "#/$defs/sha1"
        },
        "strategy_upstream_commit": {
          "$ref": "#/$defs/sha1"
        },
        "strategy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spot_surface_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "futures_surface_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "repository_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository_file"
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_paths",
        "exit_codes",
        "run_statuses",
        "error_codes"
      ],
      "properties": {
        "command_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*( [a-z][a-z0-9-]*)*$"
          }
        },
        "exit_codes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "meaning"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "run_statuses": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "error_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "source"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]+$"
              },
              "source": {
                "$ref": "#/$defs/relative_path"
              }
            }
          }
        }
      }
    },
    "full_state_fixtures": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "fixture_id",
          "manifest_path",
          "manifest_bytes",
          "manifest_sha256",
          "trade_surface_sha256",
          "state_projection_sha256"
        ],
        "properties": {
          "probe_id": {
            "type": "string",
            "minLength": 1
          },
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "manifest_path": {
            "$ref": "#/$defs/relative_path"
          },
          "manifest_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "manifest_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "trade_surface_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "state_projection_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "behavior_contracts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "expected",
          "test_nodeid"
        ],
        "properties": {
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "test_nodeid": {
            "type": "string",
            "pattern": "^tests/[A-Za-z0-9_./-]+\\.py::test_[A-Za-z0-9_]+$"
          }
        }
      }
    },
    "result_artifacts": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "media_type",
          "required_when"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_when": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "mode_contract",
          "target_commit",
          "url",
          "certificate",
          "assets"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "mode_contract": {
            "enum": [
              "binance-spot",
              "binance-usdtm-isolated"
            ]
          },
          "target_commit": {
            "$ref": "#/$defs/sha1"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/"
          },
          "certificate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset",
              "assertions"
            ],
            "properties": {
              "asset": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/assertion"
                }
              }
            }
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/release_asset"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$))"
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "equals"
      ],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "equals": true
      }
    },
    "repository_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "document",
            "schema",
            "evidence"
          ]
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    },
    "release_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        }
      }
    }
  }
}
