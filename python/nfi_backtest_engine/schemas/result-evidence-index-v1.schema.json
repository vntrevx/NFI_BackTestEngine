{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vntrevx/NFI_BackTestEngine/schemas/result-evidence-index-v1.schema.json",
  "title": "NFI Backtest Engine result evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "index_path",
    "source_evidence_immutable",
    "entries",
    "excluded_from_index"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "index_path": {
      "const": "evidence/index.json"
    },
    "source_evidence_immutable": {
      "const": true
    },
    "entries": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "excluded_from_index": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "provenance",
        "immutable_source",
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "run",
            "trade_surface",
            "summary",
            "trades_csv",
            "orders_csv",
            "equity_csv",
            "verification",
            "state_machine_ir",
            "selected_result",
            "official_fallback_report",
            "official_trade_surface"
          ]
        },
        "provenance": {
          "enum": [
            "source",
            "derived"
          ]
        },
        "immutable_source": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\).+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
