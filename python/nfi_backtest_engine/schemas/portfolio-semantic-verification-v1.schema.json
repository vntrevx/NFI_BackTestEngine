{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vntrevx/NFI_BackTestEngine/schemas/portfolio-semantic-verification-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "fixture_manifest_sha256", "official_raw_sha256", "native_raw_sha256", "official_canonical_sha256", "native_canonical_sha256", "exact", "event_count", "mismatch", "fingerprint"],
  "properties": {
    "schema_version": {"const": "portfolio-semantic-verification-v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "official_raw_sha256": {"$ref": "#/$defs/sha256"}, "native_raw_sha256": {"$ref": "#/$defs/sha256"},
    "official_canonical_sha256": {"$ref": "#/$defs/sha256"}, "native_canonical_sha256": {"$ref": "#/$defs/sha256"},
    "exact": {"type": "boolean"}, "event_count": {"type": "integer", "minimum": 0}, "fingerprint": {"$ref": "#/$defs/sha256"},
    "mismatch": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "expected", "actual", "reason"], "properties": {"path": {"type": "string", "minLength": 1}, "expected": {}, "actual": {}, "reason": {"type": "string", "minLength": 1}}}]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
