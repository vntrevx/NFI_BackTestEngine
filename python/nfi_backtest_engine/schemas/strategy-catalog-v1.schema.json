{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vntrevx/NFI_BackTestEngine/schemas/strategy-catalog-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "candidates", "summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workspace": {"type": "string"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "display_path", "name", "classes", "status", "reason_code", "reason", "blockers", "legacy", "generation", "fallback_status", "reference_runtime"],
        "properties": {
          "path": {"type": "string"},
          "display_path": {"type": "string"},
          "name": {"type": "string"},
          "classes": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["supported", "unsupported", "invalid"]},
          "reason_code": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]},
          "blockers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
            }
          },
          "legacy": {"type": "boolean"},
          "generation": {"enum": ["V8", "V9", null]},
          "fallback_status": {"enum": ["qualified", "unavailable", null]},
          "reference_runtime": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "image", "image_index_digest", "image_platform_digest", "platform"],
                "properties": {
                  "version": {"type": "string"},
                  "image": {"const": "freqtradeorg/freqtrade"},
                  "image_index_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "image_platform_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "platform": {"const": "linux/amd64"}
                }
              }
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "supported", "unsupported", "invalid"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "supported": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0}
      }
    }
  }
}
