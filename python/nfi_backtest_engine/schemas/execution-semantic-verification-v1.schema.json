{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/vntrevx/NFI_BackTestEngine/schemas/execution-semantic-verification-v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","fixture_id","fixture_manifest_sha256","official_raw_sha256","native_raw_sha256","official_canonical_sha256","native_canonical_sha256","exact","event_count","mismatch","fingerprint"],"properties":{"schema_version":{"const":"execution-semantic-verification-v1"},"fixture_id":{"type":"string","minLength":1},"fixture_manifest_sha256":{"$ref":"#/$defs/sha"},"official_raw_sha256":{"$ref":"#/$defs/sha"},"native_raw_sha256":{"$ref":"#/$defs/sha"},"official_canonical_sha256":{"$ref":"#/$defs/sha"},"native_canonical_sha256":{"$ref":"#/$defs/sha"},"exact":{"type":"boolean"},"event_count":{"type":"integer","minimum":0},"mismatch":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["path","expected","actual","reason"],"properties":{"path":{"type":"string","minLength":1},"expected":{},"actual":{},"reason":{"type":"string","minLength":1}}}]},"fingerprint":{"$ref":"#/$defs/sha"}},"$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}