{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vntrevx/NFI_BackTestEngine/schemas/changed-target-ledger-v1.schema.json",
  "title": "Current-HEAD changed semantic target proof ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "targets", "hard_blockers", "summary", "fingerprint"],
  "properties": {
    "schema_version": {"const": "changed-target-ledger-v1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_repository", "upstream_ref", "upstream_head", "baseline_commit", "old_source_sha256", "new_source_sha256", "source_closure_merkle_root", "freqtrade_digest", "semantic_profile_sha256", "semantic_registry_fingerprint"],
      "properties": {
        "upstream_repository": {"type": "string", "minLength": 1},
        "upstream_ref": {"type": "string", "minLength": 1},
        "upstream_head": {"$ref": "#/$defs/sha"},
        "baseline_commit": {"$ref": "#/$defs/sha"},
        "old_source_sha256": {"$ref": "#/$defs/sha256"},
        "new_source_sha256": {"$ref": "#/$defs/sha256"},
        "source_closure_merkle_root": {"$ref": "#/$defs/sha256"},
        "freqtrade_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "semantic_profile_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_registry_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "hard_blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_count", "blocked_target_count", "hard_blocker_count", "native_promotion_allowed"],
      "properties": {
        "target_count": {"type": "integer", "minimum": 1},
        "blocked_target_count": {"type": "integer", "minimum": 0},
        "hard_blocker_count": {"type": "integer", "minimum": 0},
        "native_promotion_allowed": {"type": "boolean"}
      }
    },
    "fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "target_id"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "target_id": {"$ref": "#/$defs/sha256"},
        "trading_mode": {"enum": ["spot", "futures"]}
      }
    },
    "mode_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trading_mode", "fixture_identity", "fixture_ids", "oracle_proof", "native_action_proof", "full_state_proof", "target_resolved"],
      "properties": {
        "trading_mode": {"enum": ["spot", "futures"]},
        "fixture_identity": {"enum": ["exact", "blocked"]},
        "fixture_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "oracle_proof": {"type": "boolean"},
        "native_action_proof": {"type": "boolean"},
        "full_state_proof": {"type": "boolean"},
        "target_resolved": {"type": "boolean"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "kind", "change", "value", "methods", "semantic_callers", "dependencies", "affected_modes", "ownership", "reachability", "mode_proofs", "hard_blockers", "native_promotion_allowed"],
      "properties": {
        "target_id": {"$ref": "#/$defs/sha256"},
        "kind": {"type": "string", "minLength": 1},
        "change": {"enum": ["added", "removed", "changed"]},
        "value": {"type": ["string", "integer"]},
        "methods": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "semantic_callers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "affected_modes": {"type": "array", "items": {"enum": ["spot", "futures"]}, "minItems": 1, "uniqueItems": true},
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mapping", "semantic_owners", "obligation_count", "obligation_ids_sha256", "duplicate_obligation_count", "reachable"],
          "properties": {
            "mapping": {"type": ["string", "null"]},
            "semantic_owners": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "obligation_count": {"type": "integer", "minimum": 0},
            "obligation_ids_sha256": {"$ref": "#/$defs/sha256"},
            "duplicate_obligation_count": {"type": "integer", "minimum": 0},
            "reachable": {"type": "boolean"}
          }
        },
        "reachability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["static", "transitive"],
          "properties": {"static": {"type": "boolean"}, "transitive": {"type": "boolean"}}
        },
        "mode_proofs": {"type": "array", "items": {"$ref": "#/$defs/mode_proof"}, "minItems": 1},
        "hard_blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
        "native_promotion_allowed": {"type": "boolean"}
      }
    }
  }
}
