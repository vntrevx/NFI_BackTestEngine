  "behavior_contracts": [
    {
      "scenario": "prepared checkpoint is resumable",
      "expected": "a prepared run records hash-bound data and vector checkpoints",
      "test_nodeid": "tests/test_research_runner.py::test_research_prepare_is_checkpointed_and_resumable"
    },
    {
      "scenario": "completed resume",
      "expected": "a complete run returns only after all result identities validate",
      "test_nodeid": "tests/test_research_runner.py::test_completed_resume_returns_verified_result_without_running_engine"
    },
    {
      "scenario": "completed evidence mutation",
      "expected": "tampered result bytes are rejected without rewriting evidence",
      "test_nodeid": "tests/test_research_runner.py::test_completed_resume_rejects_tampered_result_without_rewriting_it"
    },
    {
      "scenario": "missing completion checkpoint",
      "expected": "a result without its ordered checkpoint is rejected",
      "test_nodeid": "tests/test_research_runner.py::test_completed_resume_rejects_missing_simulation_checkpoint"
    },
    {
      "scenario": "surface-stage interruption",
      "expected": "a hash-valid simulation result is reused after presentation interruption",
      "test_nodeid": "tests/test_research_runner.py::test_surface_interruption_reuses_checkpointed_simulation_result"
    },
    {
      "scenario": "vector-stage interruption",
      "expected": "only the latest complete ordered checkpoint is reused",
      "test_nodeid": "tests/test_research_runner.py::test_vector_interruption_reuses_only_completed_checkpoint"
    },
    {
      "scenario": "unsupported semantics",
      "expected": "uncertified semantics stop before simulation with stable blocker codes",
      "test_nodeid": "tests/test_generic_adapter.py::test_generic_adapter_fails_closed_for_uncertified_spot_semantics"
    }
  ],
