{
  "schema_version": "1.1.0",
  "workflow": ".github/workflows/ci.yml",
  "required_check": {
    "job_id": "required",
    "name": "Required CI"
  },
  "docs_only": {
    "prefixes": [
      "docs/",
      "examples/"
    ],
    "files": [
      "AGENTS.md",
      "benchmarks/README.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "planning/acceptance-commands.json",
      "planning/roadmap-state.json",
      "README.md",
      "SECURITY.md"
    ]
  },
  "policy_only": {
    "prefixes": [
      ".github/ISSUE_TEMPLATE/"
    ],
    "files": [
      ".gitattributes",
      ".github/CODEOWNERS",
      ".github/ci-contract.json",
      ".github/dependabot.yml",
      ".github/scripts/ci_contract.py",
      ".github/scripts/test_ci_contract.py",
      ".github/workflows/ci.yml",
      ".gitignore",
      ".python-version"
    ]
  },
  "automation_only": {
    "prefixes": [],
    "files": [
      ".github/workflows/nfi-compatibility.yml",
      "scripts/compatibility_review_pr.py",
      "tests/test_compatibility_review_pr.py",
      "tests/test_nfi_compatibility_workflow.py"
    ]
  },
  "jobs": {
    "changes": {
      "name": "Classify changes",
      "timeout_minutes": 5
    },
    "documentation": {
      "name": "Documentation path",
      "timeout_minutes": 5
    },
    "policy": {
      "name": "CI policy checks",
      "timeout_minutes": 5
    },
    "automation": {
      "name": "Compatibility automation checks",
      "timeout_minutes": 15
    },
    "python": {
      "name": "Python ${{ matrix.os }} / ${{ matrix.python-version }}",
      "timeout_minutes": 30,
      "matrix": [
        "ubuntu-latest",
        "windows-latest",
        "macos-14",
        "3.12",
        "3.13",
        "3.14"
      ]
    },
    "quality": {
      "name": "Static and Rust checks",
      "timeout_minutes": 45
    },
    "parity": {
      "name": "Native full-parity fixtures",
      "timeout_minutes": 30
    },
    "required": {
      "name": "Required CI",
      "timeout_minutes": 5
    }
  },
  "conditional_job_ids": [
    "policy",
    "automation",
    "python",
    "quality",
    "parity"
  ],
  "classifications": {
    "docs-only": [],
    "policy-only": [
      "policy"
    ],
    "automation-only": [
      "policy",
      "automation"
    ],
    "code": [
      "python",
      "quality",
      "parity"
    ]
  },
  "coverage": {
    "text_integrity": "documentation",
    "ci_policy": "policy",
    "compatibility_automation": "automation",
    "quality": "quality",
    "python_linux": "python",
    "rust_tests": "quality",
    "platform_smoke": "python",
    "contract_parity": "parity",
    "evidence_integrity": "python"
  },
  "pull_request": {
    "event": "pull_request",
    "permissions": {
      "contents": "read"
    },
    "allows_secrets": false,
    "allows_privileged_fork_execution": false,
    "allows_official_reference": false,
    "required_capabilities_by_classification": {
      "docs-only": [
        "text_integrity"
      ],
      "policy-only": [
        "text_integrity",
        "ci_policy"
      ],
      "automation-only": [
        "text_integrity",
        "ci_policy",
        "compatibility_automation"
      ],
      "code": [
        "text_integrity",
        "quality",
        "python_linux",
        "rust_tests",
        "platform_smoke",
        "contract_parity",
        "evidence_integrity"
      ]
    }
  },
  "push": {
    "event": "push",
    "branches": [
      "main"
    ],
    "release_paths": [
      "pyproject.toml",
      ".github/product-release-contract.json",
      ".github/release-candidate-contract.json"
    ]
  },
  "concurrency": {
    "group": "ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}",
    "cancel_in_progress": true
  },
  "nightly": {
    "workflow": ".github/workflows/nightly.yml",
    "events": [
      "schedule",
      "workflow_dispatch"
    ],
    "permissions": {
      "contents": "read"
    },
    "fixture_globs": [
      "benchmarks/fixtures/captured/x7-*/manifest.json"
    ],
    "verification_level": "full",
    "shard_count": 3,
    "job_ids": [
      "inventory",
      "fixtures",
      "contracts",
      "reference"
    ],
    "failure_report": ".nightly/nightly-report.json",
    "artifact_retention_days": 14,
    "concurrency": {
      "group": "nightly-${{ github.ref }}",
      "cancel_in_progress": true
    },
    "official_reference_smoke": {
      "manifest": "benchmarks/fixtures/captured/normal-routing-spot-2025-01-01_04/manifest.json",
      "trace": "hash",
      "network": "none"
    }
  },
  "branch_protection": {
    "repository": "vntrevx/NFI_BackTestEngine",
    "branch": "main",
    "api": {
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "Required CI"
        ]
      },
      "enforce_admins": true,
      "required_pull_request_reviews": null,
      "restrictions": null
    }
  }
}
