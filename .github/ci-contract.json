{
  "schema_version": "1.0.0",
  "workflow": ".github/workflows/ci.yml",
  "required_check": {
    "job_id": "required",
    "name": "Required CI"
  },
  "docs_only": {
    "prefixes": [
      "docs/"
    ],
    "files": [
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "LICENSE",
      "README.md",
      "SECURITY.md"
    ]
  },
  "jobs": {
    "changes": {
      "name": "Classify changes",
      "timeout_minutes": 5
    },
    "documentation": {
      "name": "Documentation path",
      "timeout_minutes": 5
    },
    "python": {
      "name": "Python ${{ matrix.os }}",
      "timeout_minutes": 30,
      "matrix": [
        "ubuntu-latest",
        "windows-latest",
        "macos-14"
      ]
    },
    "quality": {
      "name": "Static and Rust checks",
      "timeout_minutes": 45
    },
    "parity": {
      "name": "Native full-parity fixtures",
      "timeout_minutes": 30
    },
    "required": {
      "name": "Required CI",
      "timeout_minutes": 5
    }
  },
  "code_job_ids": [
    "python",
    "quality",
    "parity"
  ],
  "coverage": {
    "quality": "quality",
    "python_linux": "python",
    "rust_tests": "quality",
    "platform_smoke": "python",
    "contract_parity": "parity",
    "evidence_integrity": "python"
  },
  "pull_request": {
    "event": "pull_request",
    "permissions": {
      "contents": "read"
    },
    "allows_secrets": false,
    "allows_privileged_fork_execution": false,
    "allows_official_reference": false,
    "required_capabilities": [
      "quality",
      "python_linux",
      "rust_tests",
      "platform_smoke",
      "contract_parity",
      "evidence_integrity"
    ]
  },
  "concurrency": {
    "group": "ci-${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}",
    "cancel_in_progress": true
  },
  "nightly": {
    "workflow": ".github/workflows/nightly.yml",
    "events": [
      "schedule",
      "workflow_dispatch"
    ],
    "permissions": {
      "contents": "read"
    },
    "fixture_globs": [
      "benchmarks/fixtures/captured/x7-*/manifest.json"
    ],
    "verification_level": "full",
    "shard_count": 3,
    "job_ids": [
      "inventory",
      "fixtures",
      "contracts",
      "reference"
    ],
    "failure_report": ".nightly/nightly-report.json",
    "artifact_retention_days": 14,
    "concurrency": {
      "group": "nightly-${{ github.ref }}",
      "cancel_in_progress": true
    },
    "official_reference_smoke": {
      "manifest": "benchmarks/fixtures/captured/normal-routing-spot-2025-01-01_04/manifest.json",
      "trace": "hash",
      "network": "none"
    }
  },
  "branch_protection": {
    "repository": "vntrevx/NFI_BackTestEngine",
    "branch": "main",
    "api": {
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "Required CI"
        ]
      },
      "enforce_admins": true,
      "required_pull_request_reviews": null,
      "restrictions": null
    }
  }
}
